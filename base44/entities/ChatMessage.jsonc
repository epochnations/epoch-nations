{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "global",
        "allies",
        "system"
      ],
      "default": "global"
    },
    "sender_nation_id": {
      "type": "string"
    },
    "sender_nation_name": {
      "type": "string"
    },
    "sender_flag": {
      "type": "string",
      "default": "\ud83c\udff4"
    },
    "sender_color": {
      "type": "string",
      "default": "#3b82f6"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "player",
        "ai",
        "moderator",
        "admin",
        "system"
      ],
      "default": "player"
    },
    "content": {
      "type": "string"
    },
    "is_muted": {
      "type": "boolean",
      "default": false
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "reply_to_id": {
      "type": "string",
      "default": ""
    },
    "reply_to_name": {
      "type": "string",
      "default": ""
    },
    "reactions": {
      "type": "object",
      "default": {}
    }
  },
  "required": [
    "channel",
    "sender_nation_name",
    "content"
  ]
}