{
  "name": "CouncilDilemma",
  "type": "object",
  "properties": {
    "nation_id": {
      "type": "string"
    },
    "nation_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "citizen",
        "company",
        "advisor",
        "ally"
      ],
      "default": "advisor"
    },
    "option_a_label": {
      "type": "string"
    },
    "option_a_effect": {
      "type": "string"
    },
    "option_b_label": {
      "type": "string"
    },
    "option_b_effect": {
      "type": "string"
    },
    "chosen": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "pending"
      ],
      "default": "pending"
    },
    "reaction_toast": {
      "type": "string"
    },
    "is_resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "nation_id",
    "owner_email",
    "title",
    "body"
  ]
}